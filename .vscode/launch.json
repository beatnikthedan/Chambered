{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Chambered (via Synology Proxy)",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}\\Chambered.Api\\Chambered.Api.csproj",
      "launchConfigurationId": "TargetFramework=;http",
      "env": {
        "VITE_PROXY": "true"
      }
    },
    {
      "name": "Chambered (Local Loopback)",
      "type": "dotnet",
      "request": "launch",
      "projectPath": "${workspaceFolder}\\Chambered.Api\\Chambered.Api.csproj",
      "launchConfigurationId": "TargetFramework=;http"
    }
  ]
}
